# 复制为 .env 后按需修改
PORT=3000

# development / production —— 生产环境必须显式设置为 production，
# 否则 JWT_SECRET 的默认值安全检查不会生效
NODE_ENV=development

# 前端开发服务器地址（用于 CORS 白名单），多个用逗号分隔
CORS_ORIGIN=http://localhost:5173

# SQLite 数据库文件路径（相对 backend 目录）
DB_PATH=./data/drawguess.sqlite

# JWT 签名密钥 —— 生产环境务必改成一个随机长字符串，不要沿用示例值
JWT_SECRET=change-me-to-a-random-secret
# access token 有效期（jsonwebtoken 的 expiresIn 格式，同时决定登录态 cookie 的有效期）
JWT_EXPIRES_IN=7d

# 是否在 HTTPS 环境下运行（决定登录态 cookie 是否加 secure 标记）
COOKIE_SECURE=false
# 登录态 cookie 的 SameSite 策略：同源部署用 lax 即可；
# 前后端跨站部署（不同顶级域名）必须改成 none，并同时把 COOKIE_SECURE 设为 true
COOKIE_SAME_SITE=lax

# 部署在 Nginx/Caddy 等反向代理后面时设为 true，
# 否则限流的 IP 识别、cookie 的 secure 判断都会失真
TRUST_PROXY=false
